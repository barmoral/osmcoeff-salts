<?xml version="1.0" encoding="utf-8"?>
<!--
  TIP4P/2005 water.  Abascal & Vega, J. Chem. Phys. 123, 234505 (2005).

  Built from the OpenFF tip4p_ew.offxml by substituting the four parameters
  that differ; handler versions, sections and the rigid geometry are unchanged,
  so tip4p_ew.offxml and this file differ ONLY in the water model itself.

  Parameters (LAMMPS Howto_tip4p table, converted to OpenFF units):

                        TIP4P/2005          TIP4P-Ew (for reference)
    eps_OO      0.1852 kcal/mol             0.16275 kcal/mol
              = 0.774877 kJ/mol           = 0.680946 kJ/mol
    sigma_OO    3.1589 A = 0.31589 nm       3.16435 A = 0.316435 nm
    q_H         +0.5564 e                   +0.52422 e
    q_M         -1.1128 e  (= -2 q_H)       -1.04844 e
    r_OM        0.1546 A = 0.01546 nm       0.1250 A = 0.0125 nm
    r_OH        0.9572 A   (same)           0.9572 A
    theta_HOH   104.52 deg (same)           104.52 deg

  Geometry is identical between the two models, so the Constraints section is
  copied verbatim rather than recomputed - that keeps the two files differing
  only where they are meant to.

  q_O is zero: all of the negative charge sits on the M site. In SMIRNOFF that
  is expressed as charge_increment on the two hydrogens, matching how
  tip4p_ew.offxml does it.

  Intended use: load together with ionsjc_tip4pew.offxml, ions FIRST:
      -ff ionsjc_tip4pew.offxml tip4p_2005.offxml
      -w TIP4P2005          (must NOT be the string "TIP3P")

  This reproduces the Hosseini & Ashbaugh combination exactly - they used
  TIP4P/2005 water with Joung-Cheatham ions parameterised for TIP4P/Ew,
  citing Dopke et al. (JCP 152, 024501 (2020)) for the transferability.
-->
<SMIRNOFF version="0.3" aromaticity_model="OEAroModel_MDL">
    <vdW version="0.4" potential="Lennard-Jones-12-6" combining_rules="Lorentz-Berthelot" scale12="0.0" scale13="0.0" scale14="0.5" scale15="1.0" cutoff="9.0 * angstrom ** 1" switch_width="1.0 * angstrom ** 1" periodic_method="cutoff" nonperiodic_method="no-cutoff">
        <Atom smirks="[#1]-[#8X2H2+0:1]-[#1]" epsilon="0.774877 * kilojoule_per_mole ** 1" id="n-tip4p-2005-O" sigma="0.31589 * nanometer ** 1"></Atom>
        <Atom smirks="[#1:1]-[#8X2H2+0]-[#1]" epsilon="0.0 * kilocalorie_per_mole ** 1" id="n-tip4p-2005-H" sigma="1.0 * nanometer ** 1"></Atom>
    </vdW>
    <LibraryCharges version="0.3">
        <LibraryCharge smirks="[#1]-[#8X2H2+0:1]-[#1]" charge1="0.0 * elementary_charge ** 1" id="q-tip4p-2005-O"></LibraryCharge>
        <LibraryCharge smirks="[#1:1]-[#8X2H2+0]-[#1]" charge1="0.0 * elementary_charge ** 1" id="q-tip4p-2005-H"></LibraryCharge>
    </LibraryCharges>
    <Electrostatics version="0.4" scale12="0.0" scale13="0.0" scale14="0.8333333333" scale15="1.0" cutoff="9.0 * angstrom ** 1" switch_width="0.0 * angstrom ** 1" periodic_potential="Ewald3D-ConductingBoundary" nonperiodic_potential="Coulomb" exception_potential="Coulomb"></Electrostatics>
    <Constraints version="0.3">
        <Constraint smirks="[#1:1]-[#8X2H2+0:2]-[#1]" id="c-tip4p-2005-H-O" distance="0.09572 * nanometer ** 1"></Constraint>
        <Constraint smirks="[#1:1]-[#8X2H2+0]-[#1:2]" id="c-tip4p-2005-H-O-H" distance="0.15139006545247014 * nanometer ** 1"></Constraint>
    </Constraints>
    <VirtualSites version="0.3" exclusion_policy="parents">
        <VirtualSite smirks="[#1:2]-[#8X2H2+0:1]-[#1:3]" epsilon="0.0 * kilocalorie_per_mole ** 1" type="DivalentLonePair" match="once" distance="-0.01546 * nanometer ** 1" outOfPlaneAngle="0.0 * degree ** 1" inPlaneAngle="None" charge_increment1="0.0 * elementary_charge ** 1" charge_increment2="0.5564 * elementary_charge ** 1" charge_increment3="0.5564 * elementary_charge ** 1" sigma="1.0 * angstrom ** 1" name="EP"></VirtualSite>
    </VirtualSites>
</SMIRNOFF>
