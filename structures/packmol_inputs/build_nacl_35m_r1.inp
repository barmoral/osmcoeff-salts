#
# NaCl at 3.5 mol/kg target  (same file serves HP and FBP)
# box 4.8 x 4.8 x 14.4 nm | 11089 waters | 236 ion pairs
# generated by build_salt_data.py from salt_data_48x48x144.py -- do not hand-edit
#
tolerance 2.0
filetype pdb
seed 1001
output nacl_35m_r1.pdb

structure ../water.pdb
  number 3696
  inside box 0.5 0.5 0.5 47.5 47.5 48.0
end structure
structure ../water.pdb
  number 3696
  inside box 0.5 0.5 48.0 47.5 47.5 96.0
end structure
structure ../water.pdb
  number 3697
  inside box 0.5 0.5 96.0 47.5 47.5 143.5
end structure

structure ../na.pdb
  number 236
  inside box 0.5 0.5 35.6 47.5 47.5 108.4
end structure

structure ../cl.pdb
  number 236
  inside box 0.5 0.5 35.6 47.5 47.5 108.4
end structure
