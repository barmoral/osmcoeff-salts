#
# NaCl at 3.5 mol/kg target  (same file serves HP and FBP)
# box 3.0 x 3.0 x 10.0 nm | 3008 waters | 60 ion pairs
# generated by build_salt_data.py from salt_data_30x30x100.py -- do not hand-edit
#
tolerance 2.0
filetype pdb
seed 1000
output nacl_35m_pr0.pdb

structure ../water.pdb
  number 1504
  inside box 0.5 0.5 0.5 29.5 29.5 50.0
end structure
structure ../water.pdb
  number 1504
  inside box 0.5 0.5 50.0 29.5 29.5 99.5
end structure

structure ../na.pdb
  number 60
  inside box 0.5 0.5 26.3 29.5 29.5 73.7
end structure

structure ../cl.pdb
  number 60
  inside box 0.5 0.5 26.3 29.5 29.5 73.7
end structure
